{
  "expo": {
    "name": "Stock Monitor",
    "slug": "stock-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "stockmonitor",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13151e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockmonitor.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Stock Monitor",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.stockmonitor.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13151e"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET"
      ]
    },
    "platforms": ["ios", "android"],
    "extra": {
      "eas": {
        "projectId": "1984d6e1-df7e-48a2-8f33-72509b3d06ba"
      }
    },
    "owner": "ramkumark",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1984d6e1-df7e-48a2-8f33-72509b3d06ba"
    }
  }
}
