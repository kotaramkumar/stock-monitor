{
  "expo": {
    "name": "Stock Monitor",
    "slug": "stock-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "stockmonitor",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13151e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockmonitor.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Stock Monitor",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.stockmonitor.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13151e"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
      }
    },
    "owner": "stockmonitor-dev",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a1b2c3d4-e5f6-7890-abcd-ef1234567890"
    }
  }
}
